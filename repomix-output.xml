package com.aiinterview.controller;

import com.aiinterview.dto.CodeSubmission;
import com.aiinterview.dto.CodingProblemDefinition;
import com.aiinterview.dto.ComplexityExpectation;
import com.aiinterview.dto.DSAQuestion;
import com.aiinterview.dto.ExecutionLimits;
import com.aiinterview.dto.FunctionParameter;
import com.aiinterview.dto.JudgeTestCase;
import com.aiinterview.dto.JudgeTestSuite;
import com.aiinterview.dto.SessionRecord;
import com.aiinterview.model.Interview;
import com.aiinterview.repository.InterviewRepository;
import com.aiinterview.service.AIService;
import com.aiinterview.service.CodeExecutionService;
import com.aiinterview.service.ExecutionMode;
import com.aiinterview.service.SessionService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.pdfbox.Loader;
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.text.PDFTextStripper;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

import java.time.Instant;
import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@RestController
@RequestMapping("/api/interview")
@RequiredArgsConstructor
public class InterviewController {

    private final AIService            aiService;
    private final SessionService       sessionService;
    private final CodeExecutionService codeExecutionService;
    private final InterviewRepository interviewRepository;

    private static final Set<String> ALLOWED_AUDIO_MIMES = Set.of(
            "audio/webm", "audio/ogg", "audio/mp4", "audio/mpeg",
            "audio/wav", "audio/x-wav", "audio/mp3", "video/webm"
    );
    private static final List<String> SUPPORTED_LANGUAGES = List.of("javascript", "python", "java", "cpp");
    private static final String JUDGE_UNAVAILABLE_MESSAGE =
            "Secure code execution is not configured. Set JUDGE0_BASE_URL to enable /run and /submit.";

    // ===========================================================================
    // HEALTH CHECK
    // ===========================================================================
    @GetMapping("/health")
    public ResponseEntity<Map<String, String>> health() {
        return ResponseEntity.ok(Map.of("status", "ok", "timestamp", Instant.now().toString()));
    }

    // ===========================================================================
    // 0a. TTS — ElevenLabs → OpenAI TTS → browser speech (empty buffer)
    // ===========================================================================
    @PostMapping("/tts")
    public ResponseEntity<?> textToSpeech(@RequestBody Map<String, String> body) {
        String text  = body.get("text");
        String voice = body.getOrDefault("voice", "alloy");

        if (text == null || text.isBlank()) {
            return ResponseEntity.badRequest().body(Map.of("error", "text required"));
        }
        if (text.length() > 4096) {
            return ResponseEntity.badRequest().body(Map.of("error", "text must be \u2264 4096 chars"));
        }

        try {
            byte[] audio = aiService.textToSpeech(text, voice);
            return ResponseEntity.ok()
                    .header(HttpHeaders.CONTENT_TYPE, "audio/mpeg")
                    .header(HttpHeaders.CONTENT_LENGTH, String.valueOf(audio.length))
                    .header(HttpHeaders.CACHE_CONTROL, "no-cache")
                    .body(audio);
        } catch (Exception e) {
            log.error("[TTS] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "TTS failed"));
        }
    }

    // ===========================================================================
    // 0b. STT — Whisper (OpenAI or Groq)
    // ===========================================================================
    @PostMapping(value = "/stt", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    public ResponseEntity<?> speechToText(@RequestPart("audio") MultipartFile audioFile) {
        try {
            if (audioFile == null || audioFile.isEmpty()) {
                return ResponseEntity.badRequest().body(Map.of("error", "audio file required"));
            }

            String mime = audioFile.getContentType() != null
                    ? audioFile.getContentType() : "audio/webm";

            // Strip codec parameters (e.g. "audio/webm;codecs=opus" → "audio/webm")
            String baseMime = mime.split(";")[0].trim().toLowerCase();
            if (!ALLOWED_AUDIO_MIMES.contains(baseMime)) {
                log.warn("[STT] Rejected mime: {} (base: {})", mime, baseMime);
                return ResponseEntity.badRequest().body(Map.of("error", "Unsupported audio format"));
            }

            byte[] bytes = audioFile.getBytes();
            if (bytes.length < 500) {
                log.warn("[STT] Audio too small, skipping");
                return ResponseEntity.ok(Map.of("text", ""));
            }

            log.info("[STT] Received {} bytes, mime: {}", bytes.length, mime);
            String text = aiService.speechToText(bytes, mime);
            String trimmed = text != null ? text.trim() : "";
            log.info("[STT] Transcribed: \"{}\"", trimmed);
            return ResponseEntity.ok(Map.of("text", trimmed));

        } catch (Exception e) {
            log.error("[STT] Error: {}", e.getMessage());
            return ResponseEntity.ok(Map.of("text", ""));
        }
    }

    // ===========================================================================
    // 0c. PARSE RESUME — PDF / DOCX / TXT → plain text
    // ===========================================================================
    @PostMapping(value = "/parse-resume", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    public ResponseEntity<?> parseResume(@RequestPart("resume") MultipartFile file) {
        try {
            if (file == null || file.isEmpty()) {
                return ResponseEntity.badRequest().body(Map.of("error", "No file uploaded"));
            }

            String mime = file.getContentType() != null ? file.getContentType() : "";
            String name = file.getOriginalFilename() != null ? file.getOriginalFilename().toLowerCase() : "";
            byte[] bytes = file.getBytes();
            String text;

            if (mime.equals("text/plain") || name.endsWith(".txt")) {
                text = new String(bytes);
            } else if (mime.equals("application/pdf") || name.endsWith(".pdf")) {
                try (PDDocument doc = Loader.loadPDF(bytes)) {
                    text = new PDFTextStripper().getText(doc);
                }
            } else if (mime.contains("wordprocessingml") || name.endsWith(".docx") || name.endsWith(".doc")) {
                try (XWPFDocument docx = new XWPFDocument(new java.io.ByteArrayInputStream(bytes))) {
                    text = docx.getParagraphs().stream()
                            .map(XWPFParagraph::getText)
                            .collect(Collectors.joining("\n"));
                }
            } else {
                return ResponseEntity.badRequest().body(Map.of("error", "Unsupported file type"));
            }

            String trimmed = text.substring(0, Math.min(3000, text.length()));
            return ResponseEntity.ok(Map.of("text", trimmed));

        } catch (Exception e) {
            log.error("[parse-resume] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", e.getMessage(), "text", ""));
        }
    }

    // ===========================================================================
    // 1. CREATE INTERVIEW — generate 3 DSA questions, store session
    // ===========================================================================
    @PostMapping("/create")
    public ResponseEntity<?> createInterview(@RequestBody Map<String, Object> body) {
        try {
            String difficulty = body.getOrDefault("difficulty", "medium").toString().toLowerCase();
            if (!Set.of("easy", "medium", "hard").contains(difficulty)) {
                return ResponseEntity.badRequest().body(Map.of("error", "difficulty must be easy, medium, or hard"));
            }
            String userId = body.get("userId") instanceof String s ? s : null;

            String sessionId = UUID.randomUUID().toString();
            int duration = SessionRecord.getDurationForDifficulty(difficulty);
            log.info("[CREATE] Session: {} | Difficulty: {}", sessionId, difficulty);

            List<CodingProblemDefinition> codingProblems = buildInterviewProblemSet(difficulty);
            List<DSAQuestion> questions = codingProblems.stream()
                    .map(CodingProblemDefinition::getPrompt)
                    .toList();
            DSAQuestion first = questions.get(0);

            SessionRecord session = SessionRecord.builder()
                    .id(sessionId)
                    .difficulty(difficulty)
                    .startTime(Instant.now())
                    .codingProblems(codingProblems)
                    .questions(questions)
                    .currentQuestionIndex(0)
                    .question(first)
                    .scores(new ArrayList<>())
                    .submissions(new ArrayList<>())
                    .status("active")
                    .duration(duration)
                    .createdAt(Instant.now())
                    .userId(userId)
                    .build();

            sessionService.saveSession(session);

            return ResponseEntity.status(HttpStatus.CREATED)
                    .body(Map.of(
                            "sessionId", sessionId,
                            "question", first,
                            "duration", duration,
                            "executionEnabled", codeExecutionService.isConfigured(),
                            "supportedLanguages", SUPPORTED_LANGUAGES
                    ));

        } catch (Exception e) {
            log.error("[CREATE] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Failed to create interview session"));
        }
    }

    // ===========================================================================
    // 2. RUN CODE — execute against public cases only
    // ===========================================================================
    @PostMapping("/run")
    public ResponseEntity<?> runCode(@RequestBody Map<String, Object> body) {
        if (!codeExecutionService.isConfigured()) {
            return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
                    .body(Map.of("error", JUDGE_UNAVAILABLE_MESSAGE));
        }

        try {
            ExecutionContext ctx = resolveExecutionContext(body);
            CodeSubmission submission = codeExecutionService.execute(
                    ctx.problem(), ctx.code(), ctx.language(), ExecutionMode.RUN
            );
            submission.setComplexityFeedback(aiService.analyzeCodeSubmission(
                    ctx.problem(), submission, ctx.code()
            ));

            ctx.session().getSubmissionsSafe().add(submission);
            ctx.session().getScoresSafe().add(toScoreEntry(submission));
            sessionService.saveSession(ctx.session());

            return ResponseEntity.ok(buildRunResponse(submission, ctx.session()));

        } catch (NoSuchElementException e) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", e.getMessage()));
        } catch (SecurityException e) {
            return ResponseEntity.status(HttpStatus.FORBIDDEN).body(Map.of("error", e.getMessage()));
        } catch (IllegalArgumentException e) {
            log.warn("[RUN] Validation error: {}", e.getMessage());
            return ResponseEntity.badRequest().body(Map.of("error", e.getMessage()));
        } catch (IllegalStateException e) {
            log.error("[RUN] Execution error: {}", e.getMessage());
            HttpStatus status = e.getMessage() != null && e.getMessage().contains("not configured")
                    ? HttpStatus.SERVICE_UNAVAILABLE : HttpStatus.BAD_GATEWAY;
            return ResponseEntity.status(status).body(Map.of("error", e.getMessage()));
        } catch (Exception e) {
            log.error("[RUN] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Code execution failed"));
        }
    }

    // ===========================================================================
    // 3. SUBMIT CODE — real judge against public + hidden cases
    // ===========================================================================
    @PostMapping("/submit")
    public ResponseEntity<?> submitCode(@RequestBody Map<String, Object> body) {
        if (!codeExecutionService.isConfigured()) {
            return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
                    .body(Map.of("error", JUDGE_UNAVAILABLE_MESSAGE));
        }

        try {
            ExecutionContext ctx = resolveExecutionContext(body);
            CodeSubmission submission = codeExecutionService.execute(
                    ctx.problem(), ctx.code(), ctx.language(), ExecutionMode.SUBMIT
            );
            submission.setComplexityFeedback(aiService.analyzeCodeSubmission(
                    ctx.problem(), submission, ctx.code()
            ));

            ctx.session().getSubmissionsSafe().add(submission);
            ctx.session().getScoresSafe().add(toScoreEntry(submission));

            Map<String, Object> response = buildSubmitResponse(submission, ctx.session());
            if (submission.isPassed()) {
                int nextIndex = ctx.session().getCurrentQuestionIndex() + 1;
                if (nextIndex < ctx.session().getQuestions().size()) {
                    ctx.session().setCurrentQuestionIndex(nextIndex);
                    ctx.session().setQuestion(ctx.session().getQuestions().get(nextIndex));
                    response.put("nextQuestion", ctx.session().getQuestion());
                    response.put("questionIndex", nextIndex);
                    response.put("message", "Accepted. Moving to the next question.");
                } else {
                    ctx.session().setStatus("completed");
                    ctx.session().setCompletedAt(Instant.now());
                    response.put("completed", true);
                    response.put("message", "Accepted. All questions completed!");
                }
            }

            sessionService.saveSession(ctx.session());
            return ResponseEntity.ok(response);

        } catch (NoSuchElementException e) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", e.getMessage()));
        } catch (SecurityException e) {
            return ResponseEntity.status(HttpStatus.FORBIDDEN).body(Map.of("error", e.getMessage()));
        } catch (IllegalArgumentException e) {
            log.warn("[SUBMIT] Validation error: {}", e.getMessage());
            return ResponseEntity.badRequest().body(Map.of("error", e.getMessage()));
        } catch (IllegalStateException e) {
            log.error("[SUBMIT] Execution error: {}", e.getMessage());
            HttpStatus status = e.getMessage() != null && e.getMessage().contains("not configured")
                    ? HttpStatus.SERVICE_UNAVAILABLE : HttpStatus.BAD_GATEWAY;
            return ResponseEntity.status(status).body(Map.of("error", e.getMessage()));
        } catch (Exception e) {
            log.error("[SUBMIT] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Code execution failed"));
        }
    }

    // ===========================================================================
    // 4. GET SESSION — fetch active session by id
    // ===========================================================================
    @GetMapping("/{sessionId}")
    public ResponseEntity<?> getSession(@PathVariable String sessionId) {
        Optional<SessionRecord> sessionOpt = sessionService.getSession(sessionId);
        if (sessionOpt.isEmpty()) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", "Session not found"));
        }
        SessionRecord session = sessionOpt.get();
        boolean changed = ensureExecutableProblemSet(session);
        if (changed) sessionService.saveSession(session);
        return ResponseEntity.ok(Map.of("session", sessionPayload(session)));
    }

    // ===========================================================================
    // 4. COMPLETE SESSION
    // ===========================================================================
    @PostMapping("/complete/{sessionId}")
    public ResponseEntity<?> completeSession(@PathVariable String sessionId) {
        Optional<SessionRecord> sessionOpt = sessionService.getSession(sessionId);
        if (sessionOpt.isEmpty()) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", "Session not found"));
        }
        SessionRecord session = sessionOpt.get();
        session.setStatus("completed");
        session.setCompletedAt(Instant.now());
        sessionService.saveSession(session);
        return ResponseEntity.ok(Map.of("message", "Completed"));
    }

    // ===========================================================================
    // 5. REPORT — fetch saved interview report from MongoDB
    // ===========================================================================
    @GetMapping("/report/{sessionId}")
    public ResponseEntity<?> getReport(@PathVariable String sessionId) {
        try {
            Optional<Interview> interview = interviewRepository.findBySessionId(sessionId);
            if (interview.isEmpty()) {
                return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", "Report not found"));
            }
            Interview iv = interview.get();
            Map<String, Object> resp = new HashMap<>();
            resp.put("sessionId",    iv.getSessionId());
            resp.put("score",        iv.getScore());
            resp.put("feedback",     iv.getFeedback());
            resp.put("verdict",      iv.getVerdict());
            resp.put("improvements", iv.getImprovements() != null ? iv.getImprovements() : List.of());
            resp.put("date",         iv.getDate());
            return ResponseEntity.ok(resp);
        } catch (Exception e) {
            log.error("[REPORT] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Failed to fetch report"));
        }
    }

    // ===========================================================================
    // 6. HISTORY — all past interviews for a user
    // ===========================================================================
    @GetMapping("/history/{userId}")
    public ResponseEntity<?> getHistory(@PathVariable String userId) {
        if (userId == null || userId.isBlank()) {
            return ResponseEntity.badRequest().body(Map.of("error", "userId required"));
        }
        try {
            List<Interview> interviews = interviewRepository.findByUserIdOrderByDateDesc(userId);
            List<Map<String, Object>> result = interviews.stream().map(iv -> {
                Map<String, Object> m = new HashMap<>();
                m.put("sessionId",  iv.getSessionId());
                m.put("date",       iv.getDate());
                m.put("score",      iv.getScore());
                m.put("feedback",   iv.getFeedback());
                m.put("verdict",    iv.getVerdict());
                m.put("difficulty", iv.getDifficulty());
                return m;
            }).toList();
            return ResponseEntity.ok(Map.of("interviews", result));
        } catch (Exception e) {
            log.error("[HISTORY] Error: {}", e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(Map.of("error", "Failed to fetch history"));
        }
    }

    private ExecutionContext resolveExecutionContext(Map<String, Object> body) {
        if (body == null) {
            throw new IllegalArgumentException("Request body is required");
        }

        String sessionId = body.get("sessionId") instanceof String s ? s.trim() : "";
        String code = body.get("code") instanceof String s ? s : null;
        String language = body.get("language") instanceof String s ? s.trim().toLowerCase() : "";
        String userId = body.get("userId") instanceof String s ? s : null;

        if (sessionId.isBlank() || code == null || language.isBlank()) {
            throw new IllegalArgumentException("Missing: sessionId, code, language");
        }
        if (!SUPPORTED_LANGUAGES.contains(language)) {
            throw new IllegalArgumentException("Unsupported language: " + language);
        }

        SessionRecord session = sessionService.getSession(sessionId)
                .orElseThrow(() -> new NoSuchElementException("Session not found"));

        if ("completed".equals(session.getStatus())) {
            throw new IllegalArgumentException("Interview already completed");
        }
        if (session.getUserId() != null && userId != null && !session.getUserId().equals(userId)) {
            throw new SecurityException("Unauthorized");
        }

        boolean changed = ensureExecutableProblemSet(session);
        CodingProblemDefinition problem = currentProblem(session);
        if (changed) sessionService.saveSession(session);
        return new ExecutionContext(session, problem, code, language);
    }

    private boolean ensureExecutableProblemSet(SessionRecord session) {
        if (session == null) return false;

        List<CodingProblemDefinition> desired = buildInterviewProblemSet(
                session.getDifficulty() != null ? session.getDifficulty() : "medium"
        );
        if (!session.getCodingProblemsSafe().isEmpty() && session.getCodingProblemsSafe().size() == desired.size()) {
            syncQuestionPointers(session);
            return false;
        }

        session.setCodingProblems(desired);
        session.setQuestions(desired.stream().map(CodingProblemDefinition::getPrompt).toList());
        if (session.getCurrentQuestionIndex() < 0 || session.getCurrentQuestionIndex() >= session.getQuestions().size()) {
            session.setCurrentQuestionIndex(0);
        }
        syncQuestionPointers(session);
        return true;
    }

    private void syncQuestionPointers(SessionRecord session) {
        if (session.getQuestions() == null || session.getQuestions().isEmpty()) return;
        int idx = Math.max(0, Math.min(session.getCurrentQuestionIndex(), session.getQuestions().size() - 1));
        session.setCurrentQuestionIndex(idx);
        session.setQuestion(session.getQuestions().get(idx));
    }

    private CodingProblemDefinition currentProblem(SessionRecord session) {
        if (session.getCodingProblemsSafe().isEmpty()) {
            throw new IllegalStateException("No executable coding problems are available for this session");
        }
        int idx = session.getCurrentQuestionIndex();
        if (idx < 0 || idx >= session.getCodingProblemsSafe().size()) {
            throw new IllegalStateException("Current question index is out of bounds");
        }
        return session.getCodingProblemsSafe().get(idx);
    }

    private Map<String, Object> sessionPayload(SessionRecord session) {
        Map<String, Object> payload = new HashMap<>();
        payload.put("id", session.getId());
        payload.put("difficulty", session.getDifficulty());
        payload.put("status", session.getStatus());
        payload.put("duration", session.getDuration());
        payload.put("createdAt", session.getCreatedAt());
        payload.put("completedAt", session.getCompletedAt());
        payload.put("currentQuestionIndex", session.getCurrentQuestionIndex());
        payload.put("question", session.getQuestion());
        payload.put("questions", session.getQuestions() != null ? session.getQuestions() : List.of());
        payload.put("supportedLanguages", SUPPORTED_LANGUAGES);
        payload.put("executionEnabled", codeExecutionService.isConfigured());
        return payload;
    }

    private Map<String, Object> buildRunResponse(CodeSubmission submission, SessionRecord session) {
        Map<String, Object> response = baseSubmissionResponse(submission, session);
        response.put("message", buildRunMessage(submission));
        response.put("allPublicPassed", submission.getPassedPublicCases() == submission.getTotalPublicCases());
        return response;
    }

    private Map<String, Object> buildSubmitResponse(CodeSubmission submission, SessionRecord session) {
        Map<String, Object> response = baseSubmissionResponse(submission, session);
        response.put("completed", false);
        response.put("message", buildSubmitMessage(submission));
        return response;
    }

    private Map<String, Object> baseSubmissionResponse(CodeSubmission submission, SessionRecord session) {
        Map<String, Object> response = new HashMap<>();
        response.put("mode", submission.getMode());
        response.put("questionId", submission.getQuestionId());
        response.put("questionTitle", submission.getQuestionTitle());
        response.put("questionIndex", session.getCurrentQuestionIndex());
        response.put("score", scoreFor(submission));
        response.put("passed", submission.isPassed());
        response.put("verdict", submission.getVerdict());
        response.put("runtimeMs", submission.getRuntimeMs());
        response.put("memoryKb", submission.getMemoryKb());
        response.put("passedPublicCases", submission.getPassedPublicCases());
        response.put("totalPublicCases", submission.getTotalPublicCases());
        response.put("passedHiddenCases", submission.getPassedHiddenCases());
        response.put("totalHiddenCases", submission.getTotalHiddenCases());
        response.put("caseResults", submission.getCaseResultsSafe());
        response.put("complexityFeedback", submission.getComplexityFeedback());
        return response;
    }

    private Map<String, Object> toScoreEntry(CodeSubmission submission) {
        Map<String, Object> scoreEntry = new HashMap<>();
        scoreEntry.put("score", scoreFor(submission));
        scoreEntry.put("verdict", submission.getVerdict());
        scoreEntry.put("runtimeMs", submission.getRuntimeMs());
        scoreEntry.put("memoryKb", submission.getMemoryKb());
        scoreEntry.put("passedPublicCases", submission.getPassedPublicCases());
        scoreEntry.put("totalPublicCases", submission.getTotalPublicCases());
        scoreEntry.put("passedHiddenCases", submission.getPassedHiddenCases());
        scoreEntry.put("totalHiddenCases", submission.getTotalHiddenCases());
        scoreEntry.put("mode", submission.getMode());
        scoreEntry.put("language", submission.getLanguage());
        scoreEntry.put("questionTitle", submission.getQuestionTitle());
        scoreEntry.put("complexityFeedback", submission.getComplexityFeedback());
        scoreEntry.put("submittedAt", submission.getSubmittedAt() != null ? submission.getSubmittedAt().toString() : Instant.now().toString());
        return scoreEntry;
    }

    private int scoreFor(CodeSubmission submission) {
        int total = submission.getTotalPublicCases() + submission.getTotalHiddenCases();
        int passed = submission.getPassedPublicCases() + submission.getPassedHiddenCases();
        return total == 0 ? 0 : (int) Math.round((passed * 100.0) / total);
    }

    private String buildRunMessage(CodeSubmission submission) {
        if ("Compilation Error".equals(submission.getVerdict())) {
            return "Compilation failed on the sample cases.";
        }
        if ("Time Limit Exceeded".equals(submission.getVerdict())) {
            return "Sample run hit the time limit.";
        }
        if ("Runtime Error".equals(submission.getVerdict())) {
            return "Sample run failed with a runtime error.";
        }
        return submission.getPassedPublicCases() == submission.getTotalPublicCases()
                ? "All sample test cases passed."
                : "Passed %d/%d sample test cases.".formatted(
                        submission.getPassedPublicCases(), submission.getTotalPublicCases()
                );
    }

    private String buildSubmitMessage(CodeSubmission submission) {
        if ("Compilation Error".equals(submission.getVerdict())) {
            return "Compilation failed. Fix the errors and submit again.";
        }
        if ("Time Limit Exceeded".equals(submission.getVerdict())) {
            return "Time limit exceeded on the hidden judge.";
        }
        if ("Runtime Error".equals(submission.getVerdict())) {
            return "Runtime error on the judge.";
        }

        int total = submission.getTotalPublicCases() + submission.getTotalHiddenCases();
        int passed = submission.getPassedPublicCases() + submission.getPassedHiddenCases();
        return submission.isPassed()
                ? "Accepted."
                : "Passed %d/%d total test cases.".formatted(passed, total);
    }

    private List<CodingProblemDefinition> buildInterviewProblemSet(String interviewDifficulty) {
        return switch (interviewDifficulty) {
            case "easy" -> List.of(
                    twoSumProblem("easy"),
                    validParenthesesProblem("easy"),
                    longestSubstringProblem("medium")
            );
            case "hard" -> List.of(
                    longestSubstringProblem("medium"),
                    trappingRainWaterProblem("hard"),
                    medianSortedArraysProblem("hard")
            );
            default -> List.of(
                    twoSumProblem("easy"),
                    longestSubstringProblem("medium"),
                    productExceptSelfProblem("medium")
            );
        };
    }

