# =============================================
# SERVER — REST API port
# =============================================
server.port=${PORT:5001}

# =============================================
# MONGODB
# =============================================
spring.data.mongodb.uri=${MONGODB_URI:}

# =============================================
# MULTIPART (resume upload: 5 MB, audio: 10 MB)
# =============================================
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# =============================================
# SOCKET.IO (netty-socketio) — separate port
# =============================================
socketio.port=${SOCKET_PORT:5002}
socketio.hostname=0.0.0.0

# =============================================
# AI PROVIDERS (read from .env via dotenv-java)
# =============================================
ai.openai.key=${OPENAI_API_KEY:}
ai.openai.base-url=https://api.openai.com/v1
ai.groq.key=${GROQ_API_KEY:}
ai.groq.base-url=https://api.groq.com/openai/v1
ai.elevenlabs.key=${ELEVENLABS_API_KEY:}
ai.elevenlabs.voice-id=${ELEVENLABS_VOICE_ID:pNInz6obpgDQGcFmaJgB}
ai.mock=${MOCK_AI:false}

# =============================================
# JUDGE0 — secure remote code execution
# =============================================
judge0.base-url=${JUDGE0_BASE_URL:}
judge0.api-key=${JUDGE0_API_KEY:}
judge0.auth-header=${JUDGE0_AUTH_HEADER:X-Auth-Token}
judge0.poll-max-attempts=${JUDGE0_POLL_MAX_ATTEMPTS:40}
judge0.poll-delay-ms=${JUDGE0_POLL_DELAY_MS:500}
judge0.cpu-extra-time-seconds=${JUDGE0_CPU_EXTRA_TIME_SECONDS:0.5}
judge0.wall-time-multiplier=${JUDGE0_WALL_TIME_MULTIPLIER:3.0}
judge0.stack-limit-kb=${JUDGE0_STACK_LIMIT_KB:65536}
judge0.max-processes-and-threads=${JUDGE0_MAX_PROCESSES_AND_THREADS:30}

# =============================================
