    private CodingProblemDefinition codingProblem(
            String id,
            String slug,
            String title,
            String description,
            String difficulty,
            List<String> constraints,
            List<FunctionParameter> parameters,
            String returnType,
            String functionName,
            String functionSignature,
            String inputFormat,
            String outputFormat,
            ExecutionLimits limits,
            List<JudgeTestCase> publicCases,
            List<JudgeTestCase> hiddenCases,
            Map<String, String> starterCodeByLanguage,
            String expectedTimeComplexity,
            String expectedSpaceComplexity,
            String rationale) {

        DSAQuestion prompt = DSAQuestion.builder()
                .id(id)
                .slug(slug)
                .title(title)
                .description(description)
                .difficulty(difficulty)
                .constraints(constraints)
                .testCases(publicCases.stream().map(this::displayCase).toList())
                .parameters(parameters)
                .returnType(returnType)
                .functionName(functionName)
                .functionSignature(functionSignature)
                .inputFormat(inputFormat)
                .outputFormat(outputFormat)
                .starterCodeByLanguage(starterCodeByLanguage)
                .executionLimits(limits)
                .isFallback(false)
                .build();

        return CodingProblemDefinition.builder()
                .id(id)
                .slug(slug)
                .prompt(prompt)
                .judgeTestSuite(JudgeTestSuite.builder()
                        .publicCases(publicCases)
                        .hiddenCases(hiddenCases)
                        .limits(limits)
                        .build())
                .expectedComplexity(ComplexityExpectation.builder()
                        .expectedTimeComplexity(expectedTimeComplexity)
                        .expectedSpaceComplexity(expectedSpaceComplexity)
                        .rationale(rationale)
                        .build())
                .createdAt(Instant.now())
                .build();
    }

    private JudgeTestCase judgeCase(String id, String label, List<Object> arguments, Object expectedOutput,
                                    String displayInput, String displayOutput, boolean hidden) {
        return JudgeTestCase.builder()
                .id(id)
                .label(label)
                .arguments(arguments)
                .expectedOutput(expectedOutput)
                .displayInput(displayInput)
                .displayOutput(displayOutput)
                .sample(!hidden)
                .hidden(hidden)
                .points(1)
                .build();
    }

    private DSAQuestion.TestCase displayCase(JudgeTestCase testCase) {
        return DSAQuestion.TestCase.builder()
                .id(testCase.getId())
                .input(testCase.getDisplayInput())
                .output(testCase.getDisplayOutput())
                .explanation(testCase.getExplanation())
                .sample(true)
                .build();
    }

    private Map<String, String> starterCode(String functionName, String javascript, String python, String java, String cpp) {
        Map<String, String> starter = new HashMap<>();
        starter.put("javascript", javascript.strip());
        starter.put("python", python.strip());
        starter.put("java", java.strip());
        starter.put("cpp", cpp.strip());
        return starter;
    }

    private record ExecutionContext(
            SessionRecord session,
            CodingProblemDefinition problem,
            String code,
            String language
    ) {}
}
