package com.aiinterview.service;

import com.aiinterview.dto.CodeSubmission;
import com.aiinterview.dto.CodingProblemDefinition;
import com.aiinterview.dto.ComplexityExpectation;
import com.aiinterview.dto.ComplexityFeedback;
import com.aiinterview.dto.DSAQuestion;
import com.aiinterview.dto.VerbalMessage;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.ByteArrayResource;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.util.LinkedMultiValueMap;
import org.springframework.util.MultiValueMap;
import org.springframework.util.StringUtils;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.reactive.function.client.WebClientResponseException;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.TimeUnit;

@Slf4j
public class AIService {

    // ================================================================
    // CONFIG
    // ================================================================
    @Value("${ai.openai.key:}") private String openaiKey;
    @Value("${ai.openai.base-url}") private String openaiBaseUrl;
    @Value("${ai.groq.key:}")   private String groqKey;
    @Value("${ai.groq.base-url}") private String groqBaseUrl;
    @Value("${ai.elevenlabs.key:}")  private String elevenLabsKey;
    @Value("${ai.elevenlabs.voice-id}") private String elevenLabsVoiceId;
    @Value("${ai.mock:false}")  private boolean mockMode;

    private final ObjectMapper mapper;

    public AIService(ObjectMapper mapper) {
        this.mapper = mapper;
    }

    // ================================================================
    // PROVIDER DETECTION
    // ================================================================
    private boolean hasOpenAI() {
        return StringUtils.hasText(openaiKey) && openaiKey.length() > 20 && !openaiKey.contains("your_");
    }

    private boolean hasGroq() {
        return StringUtils.hasText(groqKey) && groqKey.length() > 20 && !groqKey.contains("your_");
    }

    private boolean hasElevenLabs() {
        return StringUtils.hasText(elevenLabsKey) && elevenLabsKey.length() > 20 && !elevenLabsKey.contains("your_");
    }

    private boolean hasChatProvider() {
        return hasOpenAI() || hasGroq();
    }

    private String chatBaseUrl() {
        return hasOpenAI() ? openaiBaseUrl : groqBaseUrl;
    }

    private String chatApiKey() {
        return hasOpenAI() ? openaiKey : groqKey;
    }

    private String chatModel() {
        return hasOpenAI() ? "gpt-4o" : "llama-3.3-70b-versatile";
    }

    private String sttModel() {
        return hasOpenAI() ? "whisper-1" : "whisper-large-v3";
    }

    // ================================================================
    // INTERNAL: BUILD WebClient FOR A BASE URL + API KEY
    // ================================================================
    private WebClient webClient(String baseUrl, String apiKey) {
        return WebClient.builder()
                .baseUrl(baseUrl)
                .defaultHeader(HttpHeaders.AUTHORIZATION, "Bearer " + apiKey)
                .defaultHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                .build();
    }

    // ================================================================
    // INTERNAL: CHAT COMPLETION
    // Returns the raw content string from choices[0].message.content
    // ================================================================
    private String chatCompletion(List<Map<String, String>> messages, double temperature,
                                  int maxTokens, boolean jsonMode) {
        Map<String, Object> body = new HashMap<>();
        body.put("model", chatModel());
        body.put("messages", messages);
        body.put("temperature", temperature);
        body.put("max_tokens", maxTokens);
        if (jsonMode) {
            body.put("response_format", Map.of("type", "json_object"));
        }

        try {
            Map<?, ?> response = webClient(chatBaseUrl(), chatApiKey())
                    .post()
                    .uri("/chat/completions")
                    .bodyValue(body)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            if (response == null) return "{}";
            List<?> choices = (List<?>) response.get("choices");
            if (choices == null || choices.isEmpty()) return "{}";
            Map<?, ?> message = (Map<?, ?>) ((Map<?, ?>) choices.get(0)).get("message");
            return extractMessageContent(message);
        } catch (WebClientResponseException e) {
            log.error("Chat API error {}: {}", e.getStatusCode(), e.getResponseBodyAsString());
            return "{}";
        } catch (Exception e) {
            log.error("Chat completion failed: {}", e.getMessage());
            return "{}";
        }
    }

    // ================================================================
    // INTERNAL: CLEAN & PARSE JSON FROM LLM OUTPUT
    // LLMs sometimes wrap JSON in ```json ... ``` or add extra text.
    // ================================================================
    @SuppressWarnings("unchecked")
    private Map<String, Object> cleanAndParse(String raw) {
        try {
            if (!StringUtils.hasText(raw) || mapper == null) return null;
            String clean = raw.replaceAll("```json", "").replaceAll("```", "").trim();

            // Find first { and matching }
            int firstBrace = clean.indexOf('{');
            if (firstBrace == -1) return null;

            int braceCount = 0;
            int lastBrace = -1;
            for (int i = firstBrace; i < clean.length(); i++) {
                if (clean.charAt(i) == '{') braceCount++;
                else if (clean.charAt(i) == '}') {
                    braceCount--;
                    if (braceCount == 0) { lastBrace = i; break; }
                }
            }
            if (lastBrace == -1) return null;

            clean = clean.substring(firstBrace, lastBrace + 1);
            return mapper.readValue(clean, new TypeReference<>() {});
        } catch (Exception e) {
            String fragment = raw == null ? "<null>" : raw.substring(0, Math.min(150, raw.length()));
            log.error("JSON parse failed. Fragment: {}", fragment);
            return null;
        }
    }

    private String extractMessageContent(Map<?, ?> message) {
        if (message == null) return "{}";
        Object content = message.get("content");
        if (content instanceof String s && StringUtils.hasText(s)) {
            return s;
        }
        if (content instanceof List<?> list) {
            StringBuilder combined = new StringBuilder();
            for (Object item : list) {
                if (item instanceof Map<?, ?> part) {
                    Object text = part.get("text");
                    if (text instanceof String s && StringUtils.hasText(s)) {
                        if (!combined.isEmpty()) combined.append('\n');
                        combined.append(s);
                    }
                }
            }
            if (!combined.isEmpty()) return combined.toString();
        }
        return "{}";
    }

    private String str(Map<String, Object> m, String key, String fallback) {
        Object v = m == null ? null : m.get(key);
        return (v instanceof String s) ? s : fallback;
    }

    @SuppressWarnings("unchecked")
    private List<String> strList(Map<String, Object> m, String key) {
        Object v = m == null ? null : m.get(key);
        if (v instanceof List<?> list) {
            List<String> result = new ArrayList<>();
            for (Object item : list) {
                if (item instanceof String s) result.add(s);
            }
            return result;
        }
        return new ArrayList<>();
    }

    // ================================================================
    // TTS — ElevenLabs → OpenAI TTS → empty byte[] (browser fallback)
    // ================================================================
    public byte[] textToSpeech(String text, String voice) {
        if (mockMode) return new byte[0];

        // 1. ElevenLabs (best quality)
        if (hasElevenLabs()) {
            try {
                Map<String, Object> voiceSettings = new HashMap<>();
                voiceSettings.put("stability", 0.45);
                voiceSettings.put("similarity_boost", 0.80);
                voiceSettings.put("style", 0.35);
                voiceSettings.put("use_speaker_boost", true);

                Map<String, Object> body = new HashMap<>();
                body.put("text", text);
                body.put("model_id", "eleven_multilingual_v2");
                body.put("voice_settings", voiceSettings);

                byte[] audio = WebClient.builder()
                        .baseUrl("https://api.elevenlabs.io/v1")
                        .defaultHeader("xi-api-key", elevenLabsKey)
                        .defaultHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
                        .build()
                        .post()
                        .uri("/text-to-speech/" + elevenLabsVoiceId)
                        .bodyValue(body)
                        .retrieve()
                        .bodyToMono(byte[].class)
                        .block();

                if (audio != null && audio.length > 0) return audio;
            } catch (Exception e) {
                log.error("ElevenLabs TTS failed, falling back to OpenAI: {}", e.getMessage());
            }
        }

        // 2. OpenAI TTS
        if (hasOpenAI()) {
            try {
                List<String> validVoices = List.of("alloy", "echo", "fable", "onyx", "nova", "shimmer");
                String safeVoice = validVoices.contains(voice) ? voice : "alloy";

                Map<String, Object> body = new HashMap<>();
                body.put("model", "tts-1");
                body.put("input", text);
                body.put("voice", safeVoice);
                body.put("response_format", "mp3");

                byte[] audio = webClient(openaiBaseUrl, openaiKey)
                        .post()
                        .uri("/audio/speech")
                        .bodyValue(body)
                        .retrieve()
                        .bodyToMono(byte[].class)
                        .block();

                if (audio != null && audio.length > 0) return audio;
            } catch (Exception e) {
                log.error("OpenAI TTS failed: {}", e.getMessage());
            }
        }

        // 3. Empty buffer — browser speechSynthesis handles it
        log.warn("All TTS providers failed — returning empty buffer (browser fallback)");
        return new byte[0];
    }

    // ================================================================
    // STT — convert WebM → MP3 via ffmpeg, then send to Whisper
    // ffmpeg is required on system PATH (same requirement as Node version)
    // ================================================================
    public String speechToText(byte[] audioBytes, String mimeType) {
        if (mockMode) return "";

        Path tempIn = null;
        Path tempOut = null;
        try {
            tempIn  = Files.createTempFile("stt_in_",  ".webm");
            tempOut = Files.createTempFile("stt_out_", ".mp3");

            Files.write(tempIn, audioBytes);

            // Convert WebM → MP3 to fix corrupt duration headers (Groq rejects raw WebM)
            ProcessBuilder pb = new ProcessBuilder(
                    "ffmpeg", "-y", "-i", tempIn.toString(),
                    "-acodec", "libmp3lame", "-q:a", "2",
                    tempOut.toString()
            );
            pb.redirectErrorStream(true);
            Process process = pb.start();
            boolean finished = process.waitFor(30, TimeUnit.SECONDS);
            if (!finished) {
                process.destroyForcibly();
                log.warn("ffmpeg timed out");
                return "";
            }

            byte[] mp3Bytes = Files.readAllBytes(tempOut);
            if (mp3Bytes.length < 100) return "";

            // Build multipart/form-data request for Whisper
            ByteArrayResource audioResource = new ByteArrayResource(mp3Bytes) {
                @Override public String getFilename() { return "audio.mp3"; }
            };

            MultiValueMap<String, Object> formData = new LinkedMultiValueMap<>();
            formData.add("file", audioResource);
            formData.add("model", sttModel());
            formData.add("language", "en");
            formData.add("response_format", "json");

            Map<?, ?> response = WebClient.builder()
                    .baseUrl(chatBaseUrl())
                    .defaultHeader(HttpHeaders.AUTHORIZATION, "Bearer " + chatApiKey())
                    .build()
                    .post()
                    .uri("/audio/transcriptions")
                    .contentType(MediaType.MULTIPART_FORM_DATA)
                    .bodyValue(formData)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            if (response == null) return "";
            String text = (String) response.get("text");
            return text != null ? text.trim() : "";

        } catch (Exception e) {
            log.error("STT failed: {}", e.getMessage());
            return "";
        } finally {
            silentDelete(tempIn);
            silentDelete(tempOut);
        }
    }

    private void silentDelete(Path p) {
        if (p != null) { try { Files.deleteIfExists(p); } catch (IOException ignored) {} }
    }

    // ================================================================
    // DSA QUESTION GENERATION
    // ================================================================
    public DSAQuestion generateDSAQuestion(String level) {
        if (mockMode) return fallbackQuestion(level);

        String prompt = """
            Generate a unique %s-level Data Structures and Algorithms coding interview question.
            Return STRICT JSON only — no extra text, no markdown:
            {
              "title": "Short descriptive title",
              "description": "Clear problem statement with examples",
              "difficulty": "%s",
              "constraints": ["Constraint 1", "Constraint 2"],
              "testCases": [
                {"input": "example input 1", "output": "example output 1"},
                {"input": "example input 2", "output": "example output 2"}
              ],
              "functionSignature": "function solve(args) {"
            }
            """.formatted(level, level);

        try {
            String raw = chatCompletion(
                    List.of(Map.of("role", "user", "content", prompt)),
                    0.6, 1000, true
            );
            Map<String, Object> q = cleanAndParse(raw);
            if (q == null) throw new RuntimeException("Null parse");

            List<DSAQuestion.TestCase> testCases = new ArrayList<>();
            Object tcRaw = q.get("testCases");
            if (tcRaw instanceof List<?> list) {
                for (Object item : list) {
                    if (item instanceof Map<?, ?> m) {
                        testCases.add(new DSAQuestion.TestCase(
                                (String) m.get("input"), (String) m.get("output")));
                    }
                }
            }

            return DSAQuestion.builder()
                    .title(str(q, "title", "Unknown Problem"))
                    .description(str(q, "description", "No description provided."))
                    .difficulty(str(q, "difficulty", level))
                    .constraints(strList(q, "constraints"))
                    .testCases(testCases)
                    .functionSignature(str(q, "functionSignature", "function solution() {"))
                    .build();

        } catch (Exception e) {
            log.error("Question generation failed (using fallback): {}", e.getMessage());
            return fallbackQuestion(level);
        }
    }

    private DSAQuestion fallbackQuestion(String level) {
        return DSAQuestion.builder()
                .title("Two Sum")
                .description("Given an array of integers nums and a target integer target, return indices of the two numbers that add up to target.")
                .difficulty(level)
                .constraints(List.of("2 <= nums.length <= 10^4", "-10^9 <= nums[i] <= 10^9"))
                .testCases(List.of(
                        new DSAQuestion.TestCase("nums = [2,7,11,15], target = 9", "[0,1]"),
                        new DSAQuestion.TestCase("nums = [3,2,4], target = 6", "[1,2]")))
                .functionSignature("function twoSum(nums, target) {")
                .isFallback(true)
                .build();
    }

    // ================================================================
    // POST-JUDGE COMPLEXITY + CODE QUALITY ANALYSIS
    // Judge verdict remains the single source of truth.
    // ================================================================
    public ComplexityFeedback analyzeCodeSubmission(
            CodingProblemDefinition problem,
            CodeSubmission submission,
            String code) {

        ComplexityFeedback fallback = fallbackComplexityFeedback(problem, submission, code);
        if (problem == null || submission == null || !hasChatProvider()) {
            return fallback;
        }

        ComplexityExpectation expectation = problem.getExpectedComplexity();
        DSAQuestion prompt = problem.getPrompt();
        String expectedTime = expectation != null ? expectation.getExpectedTimeComplexity() : null;
        String expectedSpace = expectation != null ? expectation.getExpectedSpaceComplexity() : null;
        String rationale = expectation != null ? expectation.getRationale() : null;

        String analysisPrompt = """
            You are reviewing a candidate's coding submission AFTER a real judge already executed it.
            The judge verdict is authoritative. Do not re-grade correctness and do not invent a verdict.
            Your task is only to estimate time/space complexity and provide code-quality feedback.

            Problem: %s
            Difficulty: %s
            Description: %s
            Expected time complexity: %s
            Expected space complexity: %s
            Intended approach note: %s

            Judge result:
            - Verdict: %s
            - Runtime: %s ms
            - Memory: %s KB
            - Public cases: %d/%d
            - Hidden cases: %d/%d

            Language: %s
            Candidate code:
            ```%s
            %s
            ```

            Return STRICT JSON only:
            {
              "estimatedTimeComplexity": "O(...) or a short unavailable note",
              "estimatedSpaceComplexity": "O(...) or a short unavailable note",
              "codeQualitySummary": "2-3 sentences about algorithmic approach, runtime/memory fit, and code clarity. Do not restate the judge verdict as the main point.",
              "improvementSuggestions": ["suggestion 1", "suggestion 2", "suggestion 3"]
            }

            Rules:
            - Keep each suggestion concise and actionable.
            - If the code has compilation/runtime issues, say the complexity estimate is tentative.
            - If the implementation appears less efficient than the expected target, call that out clearly.
            """.formatted(
                safeText(prompt != null ? prompt.getTitle() : null, "Unknown Problem"),
                safeText(prompt != null ? prompt.getDifficulty() : null, "unknown"),
                trimForPrompt(prompt != null ? prompt.getDescription() : null, 1400),
                safeText(expectedTime, "Not specified"),
                safeText(expectedSpace, "Not specified"),
                trimForPrompt(rationale, 240),
                safeText(submission.getVerdict(), "Unknown"),
                submission.getRuntimeMs() != null ? submission.getRuntimeMs() : "unknown",
                submission.getMemoryKb() != null ? submission.getMemoryKb() : "unknown",
                submission.getPassedPublicCases(),
                submission.getTotalPublicCases(),
                submission.getPassedHiddenCases(),
                submission.getTotalHiddenCases(),
                safeText(submission.getLanguage(), "unknown"),
                safeText(submission.getLanguage(), "text"),
                trimForPrompt(code, 7000)
            );

        try {
            String raw = chatCompletion(
                    List.of(Map.of("role", "user", "content", analysisPrompt)),
                    0.1, 700, true
            );
            Map<String, Object> parsed = cleanAndParse(raw);
            if (parsed == null) return fallback;

            ComplexityFeedback aiFeedback = ComplexityFeedback.builder()
                    .estimatedTimeComplexity(
                            safeText(str(parsed, "estimatedTimeComplexity", fallback.getEstimatedTimeComplexity()),
                                    fallback.getEstimatedTimeComplexity()))
                    .estimatedSpaceComplexity(
                            safeText(str(parsed, "estimatedSpaceComplexity", fallback.getEstimatedSpaceComplexity()),
                                    fallback.getEstimatedSpaceComplexity()))
                    .codeQualitySummary(
                            safeText(str(parsed, "codeQualitySummary", fallback.getCodeQualitySummary()),
                                    fallback.getCodeQualitySummary()))
                    .improvementSuggestions(mergeSuggestions(strList(parsed, "improvementSuggestions"),
                            fallback.getImprovementSuggestions()))
                    .build();

            return normalizeComplexityFeedback(aiFeedback, fallback);
        } catch (Exception e) {
            log.warn("Post-judge complexity feedback failed, using fallback: {}", e.getMessage());
            return fallback;
        }
    }

    private ComplexityFeedback normalizeComplexityFeedback(
            ComplexityFeedback feedback,
            ComplexityFeedback fallback) {

        if (feedback == null) return fallback;
        return ComplexityFeedback.builder()
                .estimatedTimeComplexity(safeText(feedback.getEstimatedTimeComplexity(), fallback.getEstimatedTimeComplexity()))
                .estimatedSpaceComplexity(safeText(feedback.getEstimatedSpaceComplexity(), fallback.getEstimatedSpaceComplexity()))
                .codeQualitySummary(safeText(feedback.getCodeQualitySummary(), fallback.getCodeQualitySummary()))
                .improvementSuggestions(mergeSuggestions(feedback.getImprovementSuggestions(), fallback.getImprovementSuggestions()))
                .build();
    }

    private List<String> mergeSuggestions(List<String> primary, List<String> fallback) {
        List<String> merged = new ArrayList<>();
        for (String item : primary != null ? primary : List.<String>of()) {
            if (StringUtils.hasText(item) && merged.stream().noneMatch(existing -> existing.equalsIgnoreCase(item.trim()))) {
                merged.add(item.trim());
            }
            if (merged.size() == 4) return merged;
        }
        for (String item : fallback != null ? fallback : List.<String>of()) {
            if (StringUtils.hasText(item) && merged.stream().noneMatch(existing -> existing.equalsIgnoreCase(item.trim()))) {
                merged.add(item.trim());
            }
            if (merged.size() == 4) return merged;
        }
        return merged;
    }

    private ComplexityFeedback fallbackComplexityFeedback(
            CodingProblemDefinition problem,
            CodeSubmission submission,
            String code) {

        ComplexityExpectation expectation = problem != null ? problem.getExpectedComplexity() : null;
        String expectedTime = expectation != null ? expectation.getExpectedTimeComplexity() : null;
        String expectedSpace = expectation != null ? expectation.getExpectedSpaceComplexity() : null;

        String estimatedTime = estimateTimeComplexity(code, submission, expectedTime);
        String estimatedSpace = estimateSpaceComplexity(code, submission, expectedSpace);

        return ComplexityFeedback.builder()
                .estimatedTimeComplexity(estimatedTime)
                .estimatedSpaceComplexity(estimatedSpace)
                .codeQualitySummary(buildCodeQualitySummary(submission, estimatedTime, estimatedSpace, expectedTime))
                .improvementSuggestions(buildImprovementSuggestions(problem, submission, code, estimatedTime, expectedTime))
                .build();
    }

    private String estimateTimeComplexity(String code, CodeSubmission submission, String expectedTime) {
        if (submission != null && "Compilation Error".equals(submission.getVerdict())) {
            return "Unavailable until the code compiles";
        }

        String normalized = code != null ? code.toLowerCase() : "";
        if (containsAny(normalized, "arrays.sort", "collections.sort", "std::sort", ".sort(", "sorted(")) {
            return "O(n log n)";
        }

        int loops = countOccurrences(normalized, "for") + countOccurrences(normalized, "while");
        if (loops >= 3) return "O(n^3) or worse";
        if (loops >= 2) return "O(n^2)";
        if (loops == 1) {
            if (containsAny(normalized,
                    "hashmap", "unordered_map", "unordered_set", "hashset",
                    "dict(", "set(", "map<", "set<", "map[", "counter(")) {
                return "O(n)";
            }
            return safeText(expectedTime, "O(n)");
        }

        if (containsAny(normalized, "left < right", "low < high", "mid =", "mid=", "binarysearch")) {
            return "O(log n)";
        }
        return safeText(expectedTime, "O(1)");
    }

    private String estimateSpaceComplexity(String code, CodeSubmission submission, String expectedSpace) {
        if (submission != null && "Compilation Error".equals(submission.getVerdict())) {
            return "Unavailable until the code compiles";
        }

        String normalized = code != null ? code.toLowerCase() : "";
        if (containsAny(normalized, "[][]", "vector<vector", "new int[][", "new long[][", "new double[][", "new boolean[][", "new char[][")) {
            return safeText(expectedSpace, "O(n^2)");
        }
        if (containsAny(normalized,
                "hashmap", "unordered_map", "unordered_set", "hashset",
                "arraylist", "vector<", "stack<", "queue<", "deque<",
                "dict(", "set(", "list(", "append(",
                "new int[", "new long[", "new double[", "new boolean[", "new char[")) {
            return safeText(expectedSpace, "O(n)");
        }
        return safeText(expectedSpace, "O(1)");
    }

    private String buildCodeQualitySummary(
            CodeSubmission submission,
            String estimatedTime,
            String estimatedSpace,
            String expectedTime) {

        String verdict = submission != null ? submission.getVerdict() : null;
        String runtime = submission != null && submission.getRuntimeMs() != null
                ? submission.getRuntimeMs() + " ms" : "unknown runtime";
        String memory = submission != null && submission.getMemoryKb() != null
                ? submission.getMemoryKb() + " KB" : "unknown memory";

        if ("Compilation Error".equals(verdict)) {
            return "The code did not compile, so the complexity estimate is tentative. Fixing method-signature, syntax, or type issues should come before performance tuning.";
        }
        if ("Runtime Error".equals(verdict)) {
            return "The implementation reached execution but failed at runtime. The overall structure looks roughly " + estimatedTime + " time and " + estimatedSpace + " space, but stability issues need to be fixed before trusting the measurement.";
        }
        if ("Time Limit Exceeded".equals(verdict)) {
            String target = StringUtils.hasText(expectedTime) ? " The target for this problem is " + expectedTime + "." : "";
            return "The submission exceeded the judge time limit, which usually means the current approach is doing more work than necessary." + target
                    + " Judge telemetry came back at " + runtime + " and " + memory + ".";
        }
        if ("Accepted".equals(verdict)) {
            String comparison = StringUtils.hasText(expectedTime) && !expectedTime.equalsIgnoreCase(estimatedTime)
                    ? " The expected target is " + expectedTime + ", so compare your approach against that benchmark."
                    : "";
            return "The solution passed the real judge and appears to run in about " + estimatedTime + " time with " + estimatedSpace
                    + " auxiliary space based on the implementation structure. Judge telemetry was " + runtime + " and " + memory + "." + comparison;
        }
        return "The algorithm shape looks closest to " + estimatedTime + " time and " + estimatedSpace
                + " space, but at least one judge case still failed. Focus on edge-case handling before further optimization.";
    }

    private List<String> buildImprovementSuggestions(
            CodingProblemDefinition problem,
            CodeSubmission submission,
            String code,
            String estimatedTime,
            String expectedTime) {

        List<String> suggestions = new ArrayList<>();
        String verdict = submission != null ? submission.getVerdict() : null;
        String normalized = code != null ? code.toLowerCase() : "";
        ComplexityExpectation expectation = problem != null ? problem.getExpectedComplexity() : null;

        if ("Compilation Error".equals(verdict)) {
            suggestions.add("Fix the function signature, return type, and syntax issues before judging performance.");
            suggestions.add("Run the sample cases again after the code compiles cleanly.");
        } else if ("Time Limit Exceeded".equals(verdict)) {
            suggestions.add("Reduce repeated scans or nested loops to bring the runtime down.");
            if (StringUtils.hasText(expectedTime)) {
                suggestions.add("Aim for the expected time complexity target of " + expectedTime + ".");
            }
        } else if ("Runtime Error".equals(verdict)) {
            suggestions.add("Add guards for empty inputs, index bounds, and null-like edge cases.");
            suggestions.add("Trace one failing case locally to find the first invalid state.");
        } else if (!"Accepted".equals(verdict)) {
            suggestions.add("Re-check edge cases such as empty input, duplicates, and minimum-size inputs.");
        }

        if (StringUtils.hasText(expectedTime) && StringUtils.hasText(estimatedTime)
                && !"Unavailable until the code compiles".equals(estimatedTime)
                && !expectedTime.equalsIgnoreCase(estimatedTime)) {
            suggestions.add("Compare this approach with an " + expectedTime + " solution; the current structure looks closer to " + estimatedTime + ".");
        }

        if (!containsAny(normalized, "//", "#", "/*")) {
            suggestions.add("Add one or two short comments around the core idea or invariants to improve readability.");
        }

        if (countOccurrences(normalized, "if") >= 6) {
            suggestions.add("Consider extracting helper logic or simplifying branching to make the solution easier to audit.");
        }

        if (expectation != null && StringUtils.hasText(expectation.getRationale())) {
            suggestions.add("Target approach hint: " + trimForPrompt(expectation.getRationale(), 120));
        }

        return mergeSuggestions(suggestions, List.of("Verify the solution against corner cases before the next submission."));
    }

    private boolean containsAny(String text, String... needles) {
        if (!StringUtils.hasText(text)) return false;
        for (String needle : needles) {
            if (text.contains(needle)) return true;
        }
        return false;
    }

    private int countOccurrences(String text, String token) {
        if (!StringUtils.hasText(text) || !StringUtils.hasText(token)) return 0;
        int count = 0;
        int index = 0;
        while ((index = text.indexOf(token, index)) != -1) {
            boolean startsWord = index == 0 || !Character.isLetterOrDigit(text.charAt(index - 1));
            int end = index + token.length();
            boolean endsWord = end >= text.length() || !Character.isLetterOrDigit(text.charAt(end));
            if (startsWord && endsWord) count++;
            index = end;
        }
        return count;
    }

    private String trimForPrompt(String text, int maxChars) {
        if (!StringUtils.hasText(text)) return "";
        String compact = text.trim();
        return compact.length() <= maxChars ? compact : compact.substring(0, maxChars) + "...";
    }

    private String safeText(String value, String fallback) {
        return StringUtils.hasText(value) ? value.trim() : fallback;
    }

