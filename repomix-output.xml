package com.aiinterview.service;

import com.aiinterview.dto.CaseExecutionResult;
import com.aiinterview.dto.CodeSubmission;
import com.aiinterview.dto.CodingProblemDefinition;
import com.aiinterview.dto.DSAQuestion;
import com.aiinterview.dto.ExecutionLimits;
import com.aiinterview.dto.FunctionParameter;
import com.aiinterview.dto.JudgeTestCase;
import com.aiinterview.dto.JudgeTestSuite;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.reactive.function.client.WebClientResponseException;

import java.math.BigDecimal;
import java.nio.charset.StandardCharsets;
import java.time.Instant;
import java.util.ArrayList;
import java.util.Base64;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Objects;
import java.util.UUID;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class Judge0ExecutionService implements CodeExecutionService {

    @Value("${judge0.base-url:}")
    private String judge0BaseUrl;

    @Value("${judge0.api-key:}")
    private String judge0ApiKey;

    @Value("${judge0.auth-header:X-Auth-Token}")
    private String judge0AuthHeader;

    @Value("${judge0.poll-max-attempts:40}")
    private int pollMaxAttempts;

    @Value("${judge0.poll-delay-ms:500}")
    private long pollDelayMs;

    @Value("${judge0.cpu-extra-time-seconds:0.5}")
    private double cpuExtraTimeSeconds;

    @Value("${judge0.wall-time-multiplier:3.0}")
    private double wallTimeMultiplier;

    @Value("${judge0.stack-limit-kb:65536}")
    private int stackLimitKb;

    @Value("${judge0.max-processes-and-threads:30}")
    private int maxProcessesAndThreads;

    private final ObjectMapper mapper;

    @Override
    public boolean isConfigured() {
        return StringUtils.hasText(judge0BaseUrl);
    }

    @Override
    public CodeSubmission execute(CodingProblemDefinition problem, String sourceCode, String language, ExecutionMode mode) {
        requireConfigured();

        if (!StringUtils.hasText(sourceCode)) {
            throw new IllegalArgumentException("Source code is required");
        }
        if (mode == null) {
            throw new IllegalArgumentException("Execution mode is required");
        }

        SupportedLanguage supportedLanguage = SupportedLanguage.fromClientValue(language);
        ExecutionPlan plan = buildPlan(problem, sourceCode, supportedLanguage, mode);
        List<Map<String, Object>> batch = buildSubmissionBatch(plan);

        log.info("[Judge0] Executing {} testcase(s) in {} mode for problem {} using {}",
                batch.size(), mode, plan.problemId(), supportedLanguage.clientValue);

        List<String> tokens = createBatch(batch);
        List<Map<String, Object>> judgeResults = pollBatch(tokens);
        return aggregate(plan, sourceCode, judgeResults, mode, supportedLanguage.clientValue);
    }

    private ExecutionPlan buildPlan(CodingProblemDefinition problem, String sourceCode,
                                    SupportedLanguage supportedLanguage, ExecutionMode mode) {
        if (problem == null || problem.getPrompt() == null) {
            throw new IllegalArgumentException("Problem definition is missing");
        }

        DSAQuestion prompt = problem.getPrompt();
        JudgeTestSuite testSuite = problem.getJudgeTestSuite() != null
                ? problem.getJudgeTestSuite()
                : JudgeTestSuite.builder().build();
        ExecutionLimits limits = resolveLimits(prompt, testSuite);

        int sourceSizeBytes = sourceCode.getBytes(StandardCharsets.UTF_8).length;
        if (sourceSizeBytes > limits.getMaxSourceSizeBytes()) {
            throw new IllegalArgumentException("Source code exceeds max size of " + limits.getMaxSourceSizeBytes() + " bytes");
        }

        if (!StringUtils.hasText(prompt.getFunctionName())) {
            throw new IllegalArgumentException("Problem functionName is required for execution");
        }
        if (!prompt.getFunctionName().matches("[A-Za-z_][A-Za-z0-9_]*")) {
            throw new IllegalArgumentException("Invalid functionName: " + prompt.getFunctionName());
        }
        if (!StringUtils.hasText(prompt.getReturnType())) {
            throw new IllegalArgumentException("Problem returnType is required for execution");
        }

        List<FunctionParameter> parameters = prompt.getParametersSafe();
        List<TypeSpec> parameterTypes = parameters.stream()
                .map(FunctionParameter::getType)
                .map(this::parseType)
                .toList();
        TypeSpec returnType = parseType(prompt.getReturnType());

        List<JudgeTestCase> cases = new ArrayList<>(testSuite.getPublicCasesSafe());
        if (mode == ExecutionMode.SUBMIT) {
            cases.addAll(testSuite.getHiddenCasesSafe());
        }
        if (cases.isEmpty()) {
            throw new IllegalArgumentException("No testcases available for execution");
        }

        for (JudgeTestCase testCase : cases) {
            if (testCase.getArguments() == null) {
                throw new IllegalArgumentException("Testcase arguments are missing for " + testCase.getLabel());
            }
            if (testCase.getArguments().size() != parameterTypes.size()) {
                throw new IllegalArgumentException("Testcase argument count mismatch for " + labelFor(testCase));
            }
        }

        return new ExecutionPlan(
                problem.getId() != null ? problem.getId() : prompt.getId(),
                prompt,
                sourceCode,
                limits,
                supportedLanguage,
                prompt.getFunctionName(),
                parameterTypes,
                returnType,
                cases
        );
    }

    private ExecutionLimits resolveLimits(DSAQuestion prompt, JudgeTestSuite testSuite) {
        if (prompt.getExecutionLimits() != null) return prompt.getExecutionLimits();
        if (testSuite.getLimitsSafe() != null) return testSuite.getLimitsSafe();
        return ExecutionLimits.builder().build();
    }

    private List<Map<String, Object>> buildSubmissionBatch(ExecutionPlan plan) {
        List<Map<String, Object>> submissions = new ArrayList<>();
        for (JudgeTestCase testCase : plan.cases()) {
            String renderedSource = renderSource(plan, testCase);
            String expectedOutput = serializeValue(plan.returnType(), testCase.getExpectedOutput());

            Map<String, Object> submission = new LinkedHashMap<>();
            submission.put("language_id", plan.language().judge0LanguageId);
            submission.put("source_code", b64(renderedSource));
            submission.put("expected_output", b64(expectedOutput));
            submission.put("cpu_time_limit", plan.cpuTimeLimitSeconds());
            submission.put("cpu_extra_time", cpuExtraTimeSeconds);
            submission.put("wall_time_limit", plan.wallTimeLimitSeconds(wallTimeMultiplier, cpuExtraTimeSeconds));
            submission.put("memory_limit", plan.limits().getMemoryLimitKb());
            submission.put("stack_limit", stackLimitKb);
            submission.put("max_processes_and_or_threads", maxProcessesAndThreads);
            submission.put("enable_per_process_and_thread_time_limit", false);
            submission.put("enable_per_process_and_thread_memory_limit", false);
            submissions.add(submission);
        }
        return submissions;
    }

    private List<String> createBatch(List<Map<String, Object>> submissions) {
        try {
            Map<String, Object> body = Map.of("submissions", submissions);
            Object raw = webClient()
                    .post()
                    .uri(uriBuilder -> uriBuilder.path("/submissions/batch")
                            .queryParam("base64_encoded", true)
                            .build())
                    .contentType(MediaType.APPLICATION_JSON)
                    .bodyValue(body)
                    .retrieve()
                    .bodyToMono(Object.class)
                    .block();

            if (!(raw instanceof List<?> responseList)) {
                throw new IllegalStateException("Judge0 batch create returned an unexpected response");
            }
            if (responseList.size() != submissions.size()) {
                throw new IllegalStateException("Judge0 batch create returned a mismatched number of tokens");
            }

            List<String> tokens = new ArrayList<>();
            for (Object item : responseList) {
                if (!(item instanceof Map<?, ?> map)) {
                    throw new IllegalStateException("Judge0 batch create returned an invalid token item");
                }
                Object tokenObj = map.get("token");
                if (tokenObj instanceof String token && StringUtils.hasText(token)) {
                    tokens.add(token);
                    continue;
                }
                throw new IllegalStateException("Judge0 rejected submission batch: " + summarizeJudge0Error(map));
            }
            return tokens;
        } catch (WebClientResponseException e) {
            throw new IllegalStateException("Judge0 batch create failed: " + safeResponseBody(e), e);
        }
    }

    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> pollBatch(List<String> tokens) {
        String tokenQuery = String.join(",", tokens);

        for (int attempt = 0; attempt < pollMaxAttempts; attempt++) {
            try {
                Map<String, Object> response = webClient()
                        .get()
                        .uri(uriBuilder -> uriBuilder.path("/submissions/batch")
                                .queryParam("base64_encoded", true)
                                .queryParam("tokens", tokenQuery)
                                .queryParam("fields", "token,status_id,stdout,stderr,compile_output,message,time,memory")
                                .build())
                        .retrieve()
                        .bodyToMono(Map.class)
                        .block();

                Object submissionsObj = response != null ? response.get("submissions") : null;
                if (!(submissionsObj instanceof List<?> list)) {
                    throw new IllegalStateException("Judge0 batch poll returned an unexpected response");
                }

                List<Map<String, Object>> submissions = new ArrayList<>();
                for (Object item : list) {
                    if (item instanceof Map<?, ?> map) {
                        submissions.add((Map<String, Object>) map);
                    }
                }
                if (submissions.size() != tokens.size()) {
                    throw new IllegalStateException("Judge0 batch poll returned a mismatched number of results");
                }

                if (submissions.stream().allMatch(this::isTerminalStatus)) {
                    return submissions;
                }

                sleepQuietly();
            } catch (WebClientResponseException e) {
                throw new IllegalStateException("Judge0 batch poll failed: " + safeResponseBody(e), e);
            }
        }

        throw new IllegalStateException("Judge0 timed out while waiting for execution results");
    }

    private boolean isTerminalStatus(Map<String, Object> submission) {
        Integer statusId = intValue(submission.get("status_id"));
        return statusId != null && statusId != 1 && statusId != 2;
    }

    private CodeSubmission aggregate(ExecutionPlan plan, String sourceCode, List<Map<String, Object>> judgeResults,
                                     ExecutionMode mode, String language) {
        List<CaseExecutionResult> caseResults = new ArrayList<>();
        int passedPublic = 0;
        int passedHidden = 0;
        long maxRuntimeMs = 0;
        long maxMemoryKb = 0;

        for (int i = 0; i < plan.cases().size(); i++) {
            JudgeTestCase testCase = plan.cases().get(i);
            Map<String, Object> judgeResult = judgeResults.get(i);
            Integer statusId = intValue(judgeResult.get("status_id"));
            String verdict = mapJudge0Verdict(statusId);
            boolean passed = Objects.equals(statusId, 3);
            String stdout = stripTrailingLineBreaks(decodeMaybeBase64(judgeResult.get("stdout")));
            String stderr = firstNonBlank(
                    stripTrailingLineBreaks(decodeMaybeBase64(judgeResult.get("compile_output"))),
                    stripTrailingLineBreaks(decodeMaybeBase64(judgeResult.get("stderr"))),
                    stripTrailingLineBreaks(decodeMaybeBase64(judgeResult.get("message")))
            );
            Long runtimeMs = parseRuntimeMs(judgeResult.get("time"));
            Long memoryKb = longValue(judgeResult.get("memory"));

            if (runtimeMs != null) maxRuntimeMs = Math.max(maxRuntimeMs, runtimeMs);
            if (memoryKb != null) maxMemoryKb = Math.max(maxMemoryKb, memoryKb);

            if (passed) {
                if (testCase.isHidden()) passedHidden++;
                else passedPublic++;
            }

            caseResults.add(CaseExecutionResult.builder()
                    .testCaseId(StringUtils.hasText(testCase.getId()) ? testCase.getId() : "case-" + (i + 1))
                    .label(labelFor(testCase))
                    .hidden(testCase.isHidden())
                    .passed(passed)
                    .verdict(verdict)
                    .runtimeMs(runtimeMs)
                    .memoryKb(memoryKb)
                    .actualOutput(testCase.isHidden() ? null : stdout)
                    .expectedOutput(testCase.isHidden() ? null : serializeValue(plan.returnType(), testCase.getExpectedOutput()))
                    .stderr(stderr)
                    .build());
        }

        int totalPublic = (int) plan.cases().stream().filter(tc -> !tc.isHidden()).count();
        int totalHidden = (int) plan.cases().stream().filter(JudgeTestCase::isHidden).count();

        return CodeSubmission.builder()
                .id(UUID.randomUUID().toString())
                .questionId(plan.problemId())
                .questionTitle(plan.prompt().getTitle())
                .language(language)
                .mode(mode.name().toLowerCase(Locale.ROOT))
                .code(sourceCode)
                .passed(caseResults.stream().allMatch(CaseExecutionResult::isPassed))
                .verdict(overallVerdict(caseResults))
                .passedPublicCases(passedPublic)
                .totalPublicCases(totalPublic)
                .passedHiddenCases(passedHidden)
                .totalHiddenCases(totalHidden)
                .runtimeMs(maxRuntimeMs > 0 ? maxRuntimeMs : null)
                .memoryKb(maxMemoryKb > 0 ? maxMemoryKb : null)
                .caseResults(caseResults)
                .submittedAt(Instant.now())
                .build();
    }

    private String overallVerdict(List<CaseExecutionResult> results) {
        if (results.stream().allMatch(CaseExecutionResult::isPassed)) return "Accepted";
        if (results.stream().anyMatch(r -> "Compilation Error".equals(r.getVerdict()))) return "Compilation Error";
        if (results.stream().anyMatch(r -> "Time Limit Exceeded".equals(r.getVerdict()))) return "Time Limit Exceeded";
        if (results.stream().anyMatch(r -> r.getVerdict() != null && r.getVerdict().startsWith("Runtime Error"))) return "Runtime Error";
        if (results.stream().anyMatch(r -> "Internal Error".equals(r.getVerdict()))) return "Internal Error";
        return "Wrong Answer";
    }

    private String renderSource(ExecutionPlan plan, JudgeTestCase testCase) {
        return switch (plan.language()) {
            case JAVA -> renderJavaSource(plan, testCase);
            case JAVASCRIPT -> renderJavascriptSource(plan, testCase);
            case PYTHON -> renderPythonSource(plan, testCase);
            case CPP -> renderCppSource(plan, testCase);
        };
    }

    private String renderJavascriptSource(ExecutionPlan plan, JudgeTestCase testCase) {
        String joinedArgs = renderJavascriptArgs(testCase);
        return """
%s

function __serialize(value, baseType, depth) {
  if (depth === 0) {
    switch (baseType) {
      case "int":
      case "long":
        if (typeof value !== "number" || !Number.isFinite(value) || !Number.isInteger(value)) throw new Error("Expected integer result");
        return String(value);
      case "double":
        if (typeof value !== "number" || !Number.isFinite(value)) throw new Error("Expected numeric result");
        return Number.isInteger(value) ? `${value}.0` : String(value);
      case "boolean":
        if (typeof value !== "boolean") throw new Error("Expected boolean result");
        return value ? "true" : "false";
      case "string":
        if (typeof value !== "string") throw new Error("Expected string result");
        return JSON.stringify(value);
      default:
        throw new Error(`Unsupported base type: ${baseType}`);
    }
  }
  if (!Array.isArray(value)) throw new Error("Expected array result");
  return "[" + value.map(item => __serialize(item, baseType, depth - 1)).join(",") + "]";
}

if (typeof %s !== "function") {
  throw new Error("Expected function '%s' to be defined");
}

const __result = %s(%s);
process.stdout.write(__serialize(__result, "%s", %d));
""".formatted(
                planSource(plan),
                plan.functionName(),
                plan.functionName(),
                plan.functionName(),
                joinedArgs,
                plan.returnType().baseKey(),
                plan.returnType().depth()
        );
    }

    private String renderPythonSource(ExecutionPlan plan, JudgeTestCase testCase) {
        String joinedArgs = renderPythonArgs(testCase);
        return """
import json
import math

%s

def __serialize(value, base_type, depth):
    if depth == 0:
        if base_type in ("int", "long"):
            if isinstance(value, bool) or not isinstance(value, int):
                raise Exception("Expected integer result")
            return str(value)
        if base_type == "double":
            if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(float(value)):
                raise Exception("Expected numeric result")
            value = float(value)
            text = format(value, ".15g")
            return text if "." in text or "e" in text.lower() else text + ".0"
        if base_type == "boolean":
            if not isinstance(value, bool):
                raise Exception("Expected boolean result")
            return "true" if value else "false"
        if base_type == "string":
            if not isinstance(value, str):
                raise Exception("Expected string result")
            return json.dumps(value, ensure_ascii=False)
        raise Exception(f"Unsupported base type: {base_type}")
    if not isinstance(value, list):
        raise Exception("Expected array result")
    return "[" + ",".join(__serialize(item, base_type, depth - 1) for item in value) + "]"

if not callable(globals().get("%s")):
    raise Exception("Expected function '%s' to be defined")

__result = %s(%s)
print(__serialize(__result, "%s", %d), end="")
""".formatted(
                planSource(plan),
                plan.functionName(),
                plan.functionName(),
                plan.functionName(),
                joinedArgs,
                plan.returnType().baseKey(),
                plan.returnType().depth()
        );
    }

    private String renderJavaSource(ExecutionPlan plan, JudgeTestCase testCase) {
        String joinedArgs = renderTypedArgs(plan, testCase, SupportedLanguage.JAVA);
        return """
import java.math.BigDecimal;
import java.util.*;

%s

class Main {
    private static String escapeJson(String value) {
        if (value == null) return "null";
        StringBuilder out = new StringBuilder();
        out.append('"');
        for (int i = 0; i < value.length(); i++) {
            char c = value.charAt(i);
            switch (c) {
                case '\\\\' -> out.append("\\\\\\\\");
                case '"' -> out.append("\\\\\"");
                case '\\n' -> out.append("\\\\n");
                case '\\r' -> out.append("\\\\r");
                case '\\t' -> out.append("\\\\t");
                default -> {
                    if (c < 32) out.append(String.format("\\\\u%%04x", (int) c));
                    else out.append(c);
                }
            }
        }
        out.append('"');
        return out.toString();
    }

    private static String formatDouble(double value) {
        if (Double.isNaN(value) || Double.isInfinite(value)) {
            throw new IllegalStateException("Non-finite doubles are not supported");
        }
        String text = BigDecimal.valueOf(value).stripTrailingZeros().toPlainString();
        return (text.contains(".") || text.contains("E") || text.contains("e")) ? text : text + ".0";
    }

    private static String toJson(int value) { return Integer.toString(value); }
    private static String toJson(long value) { return Long.toString(value); }
    private static String toJson(double value) { return formatDouble(value); }
    private static String toJson(boolean value) { return value ? "true" : "false"; }
    private static String toJson(String value) { return escapeJson(value); }

    private static String toJson(int[] value) { return joinInts(value); }
    private static String toJson(long[] value) { return joinLongs(value); }
    private static String toJson(double[] value) { return joinDoubles(value); }
    private static String toJson(boolean[] value) { return joinBooleans(value); }
    private static String toJson(String[] value) { return joinStrings(value); }

    private static String toJson(int[][] value) { return joinIntMatrix(value); }
    private static String toJson(long[][] value) { return joinLongMatrix(value); }
    private static String toJson(double[][] value) { return joinDoubleMatrix(value); }
    private static String toJson(boolean[][] value) { return joinBooleanMatrix(value); }
    private static String toJson(String[][] value) { return joinStringMatrix(value); }

    private static String joinInts(int[] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(toJson(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinLongs(long[] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(toJson(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinDoubles(double[] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(toJson(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinBooleans(boolean[] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(toJson(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinStrings(String[] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(toJson(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinIntMatrix(int[][] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(joinInts(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinLongMatrix(long[][] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(joinLongs(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinDoubleMatrix(double[][] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(joinDoubles(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinBooleanMatrix(boolean[][] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(joinBooleans(value[i]));
        }
        return sb.append("]").toString();
    }

    private static String joinStringMatrix(String[][] value) {
        StringBuilder sb = new StringBuilder("[");
        for (int i = 0; i < value.length; i++) {
            if (i > 0) sb.append(",");
            sb.append(joinStrings(value[i]));
        }
        return sb.append("]").toString();
    }

    public static void main(String[] args) {
        Solution solution = new Solution();
        var result = solution.%s(%s);
        System.out.print(toJson(result));
    }
}
""".formatted(planSource(plan), plan.functionName(), joinedArgs);
    }

    private String renderCppSource(ExecutionPlan plan, JudgeTestCase testCase) {
        String joinedArgs = renderTypedArgs(plan, testCase, SupportedLanguage.CPP);
        return """
#include <bits/stdc++.h>
using namespace std;

%s

static string escapeJson(const string& value) {
    string out = "\"";
    for (char c : value) {
        switch (c) {
            case '\\\\': out += "\\\\\\\\"; break;
            case '"': out += "\\\\\""; break;
            case '\\n': out += "\\\\n"; break;
            case '\\r': out += "\\\\r"; break;
            case '\\t': out += "\\\\t"; break;
            default:
                if (static_cast<unsigned char>(c) < 32) {
                    char buffer[7];
                    snprintf(buffer, sizeof(buffer), "\\\\u%%04x", c);
                    out += buffer;
                } else {
                    out += c;
                }
        }
    }
    out += "\"";
    return out;
}

static string formatDouble(double value) {
    if (!std::isfinite(value)) {
        throw runtime_error("Non-finite doubles are not supported");
    }
    ostringstream oss;
    oss << setprecision(15) << value;
    string text = oss.str();
    if (text.find('.') == string::npos && text.find('e') == string::npos && text.find('E') == string::npos) {
        text += ".0";
    }
    return text;
}

static string toJson(int value) { return to_string(value); }
static string toJson(long long value) { return to_string(value); }
static string toJson(double value) { return formatDouble(value); }
static string toJson(bool value) { return value ? "true" : "false"; }
static string toJson(const string& value) { return escapeJson(value); }

template <typename T>
static string joinVector(const vector<T>& value) {
    string out = "[";
    for (size_t i = 0; i < value.size(); ++i) {
        if (i > 0) out += ",";
        out += toJson(value[i]);
    }
    out += "]";
    return out;
}

template <typename T>
static string joinMatrix(const vector<vector<T>>& value) {
    string out = "[";
    for (size_t i = 0; i < value.size(); ++i) {
        if (i > 0) out += ",";
        out += joinVector(value[i]);
    }
    out += "]";
    return out;
}

static string toJson(const vector<int>& value) { return joinVector(value); }
static string toJson(const vector<long long>& value) { return joinVector(value); }
static string toJson(const vector<double>& value) { return joinVector(value); }
static string toJson(const vector<bool>& value) { return joinVector(value); }
static string toJson(const vector<string>& value) { return joinVector(value); }

static string toJson(const vector<vector<int>>& value) { return joinMatrix(value); }
static string toJson(const vector<vector<long long>>& value) { return joinMatrix(value); }
static string toJson(const vector<vector<double>>& value) { return joinMatrix(value); }
static string toJson(const vector<vector<bool>>& value) { return joinMatrix(value); }
static string toJson(const vector<vector<string>>& value) { return joinMatrix(value); }

int main() {
    Solution solution;
    auto result = solution.%s(%s);
    cout << toJson(result);
    return 0;
}
""".formatted(planSource(plan), plan.functionName(), joinedArgs);
    }

    private String renderJavascriptArgs(JudgeTestCase testCase) {
        return testCase.getArguments().stream()
                .map(this::toJsonLiteral)
                .collect(Collectors.joining(", "));
    }

    private String renderPythonArgs(JudgeTestCase testCase) {
        return testCase.getArguments().stream()
                .map(this::toPythonLiteral)
                .collect(Collectors.joining(", "));
    }

    private String renderTypedArgs(ExecutionPlan plan, JudgeTestCase testCase, SupportedLanguage language) {
        List<String> args = new ArrayList<>();
        for (int i = 0; i < plan.parameterTypes().size(); i++) {
            TypeSpec type = plan.parameterTypes().get(i);
            Object value = testCase.getArguments().get(i);
            args.add(switch (language) {
                case JAVA -> renderJavaLiteral(type, value);
                case CPP -> renderCppLiteral(type, value);
                default -> throw new IllegalStateException("Typed arguments are only used for Java/C++");
            });
        }
        return String.join(", ", args);
    }

    private String renderJavaLiteral(TypeSpec type, Object value) {
        if (type.depth() == 0) {
            return switch (type.scalar()) {
                case INT -> Integer.toString(coerceInteger(value));
                case LONG -> Long.toString(coerceLong(value)) + "L";
                case DOUBLE -> formatDoubleLiteral(coerceDouble(value));
                case BOOLEAN -> Boolean.toString(coerceBoolean(value));
                case STRING -> "\"" + escapeJavaString(coerceString(value)) + "\"";
            };
        }

        List<?> list = coerceList(value);
        String elementType = type.javaElementType();
        TypeSpec child = type.elementType();
        return "new " + elementType + "[]{" + list.stream()
                .map(item -> renderJavaLiteral(child, item))
                .collect(Collectors.joining(", ")) + "}";
    }

    private String renderCppLiteral(TypeSpec type, Object value) {
        if (type.depth() == 0) {
            return switch (type.scalar()) {
                case INT -> Integer.toString(coerceInteger(value));
                case LONG -> Long.toString(coerceLong(value)) + "LL";
                case DOUBLE -> formatDoubleLiteral(coerceDouble(value));
                case BOOLEAN -> coerceBoolean(value) ? "true" : "false";
                case STRING -> "\"" + escapeCppString(coerceString(value)) + "\"";
            };
        }

        List<?> list = coerceList(value);
        TypeSpec child = type.elementType();
        return type.cppType() + "{" + list.stream()
                .map(item -> renderCppLiteral(child, item))
                .collect(Collectors.joining(", ")) + "}";
    }

    private String serializeValue(TypeSpec type, Object value) {
        if (type.depth() == 0) {
            return switch (type.scalar()) {
                case INT -> Integer.toString(coerceInteger(value));
                case LONG -> Long.toString(coerceLong(value));
                case DOUBLE -> formatDoubleLiteral(coerceDouble(value));
                case BOOLEAN -> coerceBoolean(value) ? "true" : "false";
                case STRING -> toJsonLiteral(coerceString(value));
            };
        }

        List<?> list = coerceList(value);
        TypeSpec child = type.elementType();
        return "[" + list.stream()
                .map(item -> serializeValue(child, item))
                .collect(Collectors.joining(",")) + "]";
    }

    private String toJsonLiteral(Object value) {
        try {
            return mapper.writeValueAsString(value);
        } catch (JsonProcessingException e) {
            throw new IllegalArgumentException("Failed to serialize testcase literal", e);
        }
    }

    private String toPythonLiteral(Object value) {
        if (value == null) return "None";
        if (value instanceof Boolean b) return b ? "True" : "False";
        if (value instanceof Number) return value.toString();
        if (value instanceof String s) return toJsonLiteral(s);
        if (value instanceof List<?> list) {
            return "[" + list.stream().map(this::toPythonLiteral).collect(Collectors.joining(", ")) + "]";
        }
        if (value instanceof Map<?, ?> map) {
            return "{" + map.entrySet().stream()
                    .map(entry -> toPythonLiteral(entry.getKey()) + ": " + toPythonLiteral(entry.getValue()))
                    .collect(Collectors.joining(", ")) + "}";
        }
        return toJsonLiteral(value);
    }

    private String mapJudge0Verdict(Integer statusId) {
        if (statusId == null) return "Internal Error";
        return switch (statusId) {
            case 3 -> "Accepted";
            case 4 -> "Wrong Answer";
            case 5 -> "Time Limit Exceeded";
            case 6 -> "Compilation Error";
            case 7, 8, 9, 10, 11, 12, 14 -> "Runtime Error";
            default -> "Internal Error";
        };
    }

    private void requireConfigured() {
        if (!isConfigured()) {
            throw new IllegalStateException("Judge0 is not configured. Set JUDGE0_BASE_URL before executing code.");
        }
    }

    private WebClient webClient() {
        WebClient.Builder builder = WebClient.builder()
                .baseUrl(judge0BaseUrl)
                .defaultHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE);

        if (StringUtils.hasText(judge0ApiKey)) {
            builder.defaultHeader(judge0AuthHeader, judge0ApiKey);
        }
        return builder.build();
    }

    private void sleepQuietly() {
        try {
            Thread.sleep(pollDelayMs);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            throw new IllegalStateException("Interrupted while waiting for Judge0 results", e);
        }
    }

    private String summarizeJudge0Error(Map<?, ?> errorMap) {
        return errorMap.entrySet().stream()
                .map(entry -> entry.getKey() + "=" + entry.getValue())
                .collect(Collectors.joining(", "));
    }

    private String safeResponseBody(WebClientResponseException e) {
        String body = e.getResponseBodyAsString();
        return StringUtils.hasText(body) ? body : e.getStatusText();
    }

    private String decodeMaybeBase64(Object value) {
        if (!(value instanceof String text) || !StringUtils.hasText(text)) {
            return null;
        }
        try {
            return new String(Base64.getDecoder().decode(text), StandardCharsets.UTF_8);
        } catch (IllegalArgumentException ignored) {
            return text;
        }
    }

    private String b64(String value) {
        return Base64.getEncoder().encodeToString(value.getBytes(StandardCharsets.UTF_8));
    }

    private Integer intValue(Object value) {
        if (value instanceof Number n) return n.intValue();
        if (value instanceof String s && StringUtils.hasText(s)) return Integer.parseInt(s);
        return null;
    }

    private Long longValue(Object value) {
        if (value instanceof Number n) return n.longValue();
        if (value instanceof String s && StringUtils.hasText(s)) return Long.parseLong(s);
        return null;
    }

    private Long parseRuntimeMs(Object value) {
        if (value == null) return null;
        String text = value.toString().trim();
        if (text.isEmpty()) return null;
        return BigDecimal.valueOf(Double.parseDouble(text)).movePointRight(3).longValue();
    }

    private String firstNonBlank(String... values) {
        for (String value : values) {
            if (StringUtils.hasText(value)) return value;
        }
        return null;
    }

    private String stripTrailingLineBreaks(String value) {
        if (value == null) return null;
        return value.replaceFirst("[\\r\\n]+$", "");
    }

    private String labelFor(JudgeTestCase testCase) {
        if (StringUtils.hasText(testCase.getLabel())) return testCase.getLabel();
        if (testCase.isHidden()) return "Hidden Case";
        return "Case";
    }

    private List<?> coerceList(Object value) {
        if (value instanceof List<?> list) return list;
        throw new IllegalArgumentException("Expected array testcase argument but got " + value);
    }

    private int coerceInteger(Object value) {
        if (value instanceof Number n) return n.intValue();
        throw new IllegalArgumentException("Expected integer value but got " + value);
    }

    private long coerceLong(Object value) {
        if (value instanceof Number n) return n.longValue();
        throw new IllegalArgumentException("Expected long value but got " + value);
    }

    private double coerceDouble(Object value) {
        if (value instanceof Number n) return n.doubleValue();
        throw new IllegalArgumentException("Expected numeric value but got " + value);
    }

    private boolean coerceBoolean(Object value) {
        if (value instanceof Boolean b) return b;
        throw new IllegalArgumentException("Expected boolean value but got " + value);
    }

    private String coerceString(Object value) {
        if (value instanceof String s) return s;
        throw new IllegalArgumentException("Expected string value but got " + value);
    }

    private String formatDoubleLiteral(double value) {
        if (Double.isNaN(value) || Double.isInfinite(value)) {
            throw new IllegalArgumentException("Non-finite doubles are not supported");
        }
        String text = BigDecimal.valueOf(value).stripTrailingZeros().toPlainString();
        return (text.contains(".") || text.contains("E") || text.contains("e")) ? text : text + ".0";
    }

    private String escapeJavaString(String value) {
        return value
                .replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r")
                .replace("\t", "\\t");
    }

    private String escapeCppString(String value) {
        return escapeJavaString(value);
    }

    private TypeSpec parseType(String rawType) {
        if (!StringUtils.hasText(rawType)) {
            throw new IllegalArgumentException("Type metadata is required");
        }

        String current = rawType.trim();
        int depth = 0;

        while (current.endsWith("[]")) {
            depth++;
            current = current.substring(0, current.length() - 2).trim();
        }
        while (current.toLowerCase(Locale.ROOT).startsWith("array<") && current.endsWith(">")) {
            depth++;
            current = current.substring(6, current.length() - 1).trim();
        }
        if (depth > 2) {
            throw new IllegalArgumentException("Only up to 2D arrays are supported right now: " + rawType);
        }

        ScalarType scalar = switch (current.toLowerCase(Locale.ROOT)) {
            case "int", "integer" -> ScalarType.INT;
            case "long" -> ScalarType.LONG;
            case "double", "float", "number" -> ScalarType.DOUBLE;
            case "bool", "boolean" -> ScalarType.BOOLEAN;
            case "string", "str" -> ScalarType.STRING;
            default -> throw new IllegalArgumentException("Unsupported type metadata: " + rawType);
        };

        return new TypeSpec(scalar, depth, rawType);
    }

    private String planSource(ExecutionPlan plan) {
        return plan.sourceCode();
    }

    private record ExecutionPlan(
            String problemId,
            DSAQuestion prompt,
            String sourceCode,
            ExecutionLimits limits,
            SupportedLanguage language,
            String functionName,
            List<TypeSpec> parameterTypes,
            TypeSpec returnType,
            List<JudgeTestCase> cases
    ) {
        double cpuTimeLimitSeconds() {
            return Math.max(0.25d, limits.getTimeLimitMs() / 1000.0d);
        }

        double wallTimeLimitSeconds(double wallMultiplier, double extraCpuTimeSeconds) {
            return Math.max(cpuTimeLimitSeconds() + extraCpuTimeSeconds + 0.5d, cpuTimeLimitSeconds() * wallMultiplier);
        }
    }

    private enum SupportedLanguage {
        JAVA("java", 62),
        JAVASCRIPT("javascript", 63),
        PYTHON("python", 71),
        CPP("cpp", 54);

        private final String clientValue;
        private final int judge0LanguageId;

        SupportedLanguage(String clientValue, int judge0LanguageId) {
            this.clientValue = clientValue;
            this.judge0LanguageId = judge0LanguageId;
        }

        private static SupportedLanguage fromClientValue(String value) {
            if (!StringUtils.hasText(value)) {
                throw new IllegalArgumentException("Language is required");
            }
            String normalized = value.trim().toLowerCase(Locale.ROOT);
            for (SupportedLanguage language : values()) {
                if (language.clientValue.equals(normalized)) return language;
            }
            throw new IllegalArgumentException("Unsupported language: " + value);
        }
    }

    private enum ScalarType {
        INT("int", "int", "int"),
        LONG("long", "long", "long long"),
        DOUBLE("double", "double", "double"),
        BOOLEAN("boolean", "boolean", "bool"),
        STRING("string", "String", "string");

        private final String baseKey;
        private final String javaType;
        private final String cppType;

        ScalarType(String baseKey, String javaType, String cppType) {
            this.baseKey = baseKey;
            this.javaType = javaType;
            this.cppType = cppType;
        }
    }

    private record TypeSpec(ScalarType scalar, int depth, String raw) {
        TypeSpec elementType() {
            return new TypeSpec(scalar, depth - 1, raw);
        }

        String baseKey() {
            return scalar.baseKey;
        }

        String javaElementType() {
            return scalar.javaType + "[]".repeat(Math.max(depth - 1, 0));
        }

        String cppType() {
            String type = scalar.cppType;
            for (int i = 0; i < depth; i++) {
                type = "vector<" + type + ">";
            }
            return type;
        }
    }
}
