          border: 1px solid #a855f730;
          border-radius: 8px;
          transition: background 0.2s, border-color 0.2s;
          flex-shrink: 0;
        }
        .view-btn:hover {
          background: #a855f718;
          border-color: #a855f7;
        }
        @media (max-width: 600px) {
          .card { flex-wrap: wrap; }
          .view-btn { width: 100%; text-align: center; }
        }
      `}</style>
    </div>
  );
}
