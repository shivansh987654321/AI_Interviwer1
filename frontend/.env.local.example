# ============================================================
# AI INTERVIEWER FRONTEND — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
# ============================================================

# ============================================================
# CLERK AUTHENTICATION (required for login / sign-up)
# ============================================================
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk routes — these must match the pages you create
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ============================================================
# BACKEND API URL (defaults to localhost:5001 if not set)
# ============================================================
# Change to your production backend URL when deploying
NEXT_PUBLIC_API_URL=http://localhost:5001
