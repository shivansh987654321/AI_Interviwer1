# ============================================================
# AI INTERVIEWER PLATFORM — ENVIRONMENT VARIABLES (Java)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ============================================================
# AI PROVIDERS — at least one chat key is required
# ============================================================

# OpenAI API key — https://platform.openai.com/api-keys
# Powers: GPT-4o (chat), whisper-1 (STT), tts-1 (TTS fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API key — FREE at https://console.groq.com/keys
# Powers: llama-3.3-70b (chat + code eval), whisper-large-v3 (STT)
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API key — https://elevenlabs.io
# Provides ultra-realistic AI voice for the interviewer (Alex)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ============================================================
# MOCK MODE — set true to skip all AI API calls (free dev/test)
# ============================================================
MOCK_AI=false

# ============================================================
# DATABASE — MongoDB (file-based fallback if not set)
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-interview?retryWrites=true&w=majority

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# REST API port (Spring Boot)
PORT=5001
# Socket.IO port (netty-socketio)
SOCKET_PORT=5002
# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000
# Session TTL in hours
SESSION_TTL_HOURS=24
