# ============================================================
# AI INTERVIEWER PLATFORM — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ============================================================
# REQUIRED — The app will not start without this
# ============================================================

# OpenAI API key — get yours at https://platform.openai.com/api-keys
# Used for: GPT-4o (chat), whisper-1 (STT), tts-1 (TTS fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API key — FREE at https://console.groq.com/keys
# Used as FALLBACK if OPENAI_API_KEY is missing or invalid
# Provides: llama-3.3-70b (chat + code eval), whisper-large-v3 (STT)
# Note: Groq has NO TTS — voice falls back to browser speechSynthesis
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API key — get yours at https://elevenlabs.io
# Provides ultra-realistic AI voice for the interviewer (Alex)
# Priority: ElevenLabs → OpenAI TTS → browser speechSynthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: customize the interviewer voice (default: Adam — professional male)
# Browse voices at https://elevenlabs.io/voice-library
# pNInz6obpgDQGcFmaJgB = Adam  |  21m00Tcm4TlvDq8ikWAM = Rachel
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ============================================================
# MOCK / TEST MODE (set to true to skip ALL OpenAI API calls)
# ============================================================
# When MOCK_AI=true, the server returns instant static responses
# so you can develop and test WITHOUT spending any API credits.
# Set to false (or remove) in production.
MOCK_AI=false

# ============================================================
# OPTIONAL — Database persistence (file-based fallback if omitted)
# ============================================================

# MongoDB connection string — get one free at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-interview?retryWrites=true&w=majority

# ============================================================
# SERVER CONFIGURATION (defaults shown)
# ============================================================

# Port the backend HTTP server listens on (default: 5001)
PORT=5001

# Frontend origin for CORS allow-list — update when deploying to production
FRONTEND_URL=http://localhost:3000

# Node environment: development | production
NODE_ENV=development
